# =============================================================================
# KYC Attestation Platform - Environment Configuration
# =============================================================================

# =============================================================================
# PLATFORM CONFIGURATION
# =============================================================================
# Production domain for the platform
PLATFORM_DOMAIN="https://identhor.com"

# API versioning
API_VERSION="v1"

# Application port
PORT=3000

# Node environment
NODE_ENV="development"

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# For local development, connect to a PostgreSQL instance running on your host
# or a separate Docker container if not using docker-compose.yml for the backend.
# If using the docker-compose.yml above, the DATABASE_URL there will be used by the backend service.
DATABASE_URL="postgresql://user:password@localhost:5432/mydatabase?schema=public"

# =============================================================================
# IDENFY CONFIGURATION
# =============================================================================
# iDenfy API credentials
IDENFY_API_ACCESS_KEY="your_idenfy_api_access_key_here"
IDENFY_API_SECRET_KEY="your_idenfy_api_secret_key_here"

# iDenfy webhook secret for signature validation
IDENFY_WEBHOOK_SECRET="your_idenfy_webhook_secret_here"

# iDenfy environment (sandbox or production)
IDENFY_ENVIRONMENT="sandbox"

# iDenfy base URL
IDENFY_BASE_URL="https://ivs.idenfy.com"

# =============================================================================
# NGROK CONFIGURATION (Development Only)
# =============================================================================
# Enable ngrok for external webhook access during development
ENABLE_NGROK="false"

# Ngrok auth token (get from https://dashboard.ngrok.com/get-started/your-authtoken)
NGROK_AUTH_TOKEN="your_ngrok_auth_token_here"

# Ngrok region (us, eu, au, ap, sa, jp, in)
NGROK_REGION="us"

# Ngrok subdomain (optional, requires paid plan)
NGROK_SUBDOMAIN=""

# =============================================================================
# JWT CONFIGURATION
# =============================================================================
# JWT secret for token generation
JWT_SECRET="your_jwt_secret_here"

# JWT expiration time
JWT_EXPIRES_IN="15m"

# JWT refresh token expiration
JWT_REFRESH_EXPIRES_IN="7d"

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Allowed origins for CORS
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,https://identhor.com"

# =============================================================================
# RATE LIMITING
# =============================================================================
# Rate limiting configuration
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# =============================================================================
# LOGGING
# =============================================================================
# Log level
LOG_LEVEL="debug"

# =============================================================================
# BLOCKCHAIN PROVIDER ABSTRACTION
# =============================================================================
# Primary blockchain provider configuration
PRIMARY_BLOCKCHAIN_PROVIDER="HYPERLEDGER_FABRIC"
PRIMARY_BLOCKCHAIN_NETWORK="kycchannel"

# Provider timeouts and connection settings
BLOCKCHAIN_CONNECTION_TIMEOUT=30000
BLOCKCHAIN_REQUEST_TIMEOUT=10000
BLOCKCHAIN_MAX_RETRIES=3
BLOCKCHAIN_HEALTH_CHECK_INTERVAL=60000

# =============================================================================
# HYPERLEDGER FABRIC CONFIGURATION
# =============================================================================
# Fabric network connection profile path
FABRIC_CONNECTION_PROFILE_PATH="./fabric-network/connection-profile.json"

# Fabric wallet configuration
FABRIC_WALLET_PATH="./wallet"
FABRIC_IDENTITY_NAME="appUser"

# Fabric network settings
FABRIC_CHANNEL_NAME="kycchannel"
FABRIC_CHAINCODE_NAME="kycattestation"
FABRIC_MSP_ID="Org1MSP"

# Fabric connection options
FABRIC_ENABLE_DISCOVERY="true"
FABRIC_AS_LOCALHOST="true"

# =============================================================================
# ETHEREUM CONFIGURATION (Future Implementation)
# =============================================================================
# Ethereum RPC configuration
# ETHEREUM_RPC_URL="https://mainnet.infura.io/v3/your-project-id"
# ETHEREUM_BACKUP_RPC_URLS="https://eth-mainnet.alchemyapi.io/v2/your-api-key"
# ETHEREUM_CHAIN_ID=1
# ETHEREUM_PRIVATE_KEY="your_private_key_here"
# ETHEREUM_GAS_STRATEGY="eip1559"
# ETHEREUM_CONFIRMATIONS=3

# Smart contract addresses
# ATTESTATION_CONTRACT_ADDRESS="0x..."

# =============================================================================
# EMAIL CONFIGURATION (SendGrid)
# =============================================================================
# SendGrid API key
SENDGRID_API_KEY="your_sendgrid_api_key_here"

# SendGrid domain
SENDGRID_DOMAIN="mail.identhor.com"

# SendGrid region (US or EU)
SENDGRID_REGION="US"

# SendGrid webhook secret (optional - not needed for MVP)
# SENDGRID_WEBHOOK_SECRET="your_sendgrid_webhook_secret_here"

# =============================================================================
# SECURITY
# =============================================================================
# Encryption key for sensitive data
ENCRYPTION_KEY="your_32_character_encryption_key_here"

# Session secret
SESSION_SECRET="your_session_secret_here"

# =============================================================================
# MONITORING
# =============================================================================
# Health check endpoint
HEALTH_CHECK_ENABLED="true"

# Metrics collection
METRICS_ENABLED="false" 