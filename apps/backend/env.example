# =============================================================================
# KYC Attestation Platform - Environment Configuration
# =============================================================================

# =============================================================================
# PLATFORM CONFIGURATION
# =============================================================================
# Production domain for the platform
PLATFORM_DOMAIN="https://identhor.com"

# API versioning
API_VERSION="v1"

# Application port
PORT=3000

# Node environment
NODE_ENV="development"

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# For local development, connect to a PostgreSQL instance running on your host
# or a separate Docker container if not using docker-compose.yml for the backend.
# If using the docker-compose.yml above, the DATABASE_URL there will be used by the backend service.
DATABASE_URL="postgresql://user:password@localhost:5432/mydatabase?schema=public"

# =============================================================================
# IDENFY CONFIGURATION
# =============================================================================
# iDenfy API credentials
IDENFY_API_ACCESS_KEY="your_idenfy_api_access_key_here"
IDENFY_API_SECRET_KEY="your_idenfy_api_secret_key_here"

# iDenfy webhook secret for signature validation
IDENFY_WEBHOOK_SECRET="your_idenfy_webhook_secret_here"

# iDenfy environment (sandbox or production)
IDENFY_ENVIRONMENT="sandbox"

# iDenfy base URL
IDENFY_BASE_URL="https://ivs.idenfy.com"

# =============================================================================
# NGROK CONFIGURATION (Development Only)
# =============================================================================
# Enable ngrok for external webhook access during development
ENABLE_NGROK="false"

# Ngrok auth token (get from https://dashboard.ngrok.com/get-started/your-authtoken)
NGROK_AUTH_TOKEN="your_ngrok_auth_token_here"

# Ngrok region (us, eu, au, ap, sa, jp, in)
NGROK_REGION="us"

# Ngrok subdomain (optional, requires paid plan)
NGROK_SUBDOMAIN=""

# =============================================================================
# JWT CONFIGURATION
# =============================================================================
# JWT secret for token generation
JWT_SECRET="your_jwt_secret_here"

# JWT expiration time
JWT_EXPIRES_IN="15m"

# JWT refresh token expiration
JWT_REFRESH_EXPIRES_IN="7d"

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Allowed origins for CORS
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,https://identhor.com"

# =============================================================================
# RATE LIMITING
# =============================================================================
# Rate limiting configuration
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# =============================================================================
# LOGGING
# =============================================================================
# Log level
LOG_LEVEL="debug"

# =============================================================================
# BLOCKCHAIN CONFIGURATION
# =============================================================================
# Hyperledger Fabric network configuration
FABRIC_NETWORK_CONFIG_PATH="./fabric-network/connection-profile.json"

# =============================================================================
# EMAIL CONFIGURATION (Future - Mailgun)
# =============================================================================
# Mailgun API key
MAILGUN_API_KEY="your_mailgun_api_key_here"

# Mailgun domain
MAILGUN_DOMAIN="mail.identhor.com"

# Mailgun region (US or EU)
MAILGUN_REGION="US"

# Mailgun webhook secret
MAILGUN_WEBHOOK_SECRET="your_mailgun_webhook_secret_here"

# =============================================================================
# SECURITY
# =============================================================================
# Encryption key for sensitive data
ENCRYPTION_KEY="your_32_character_encryption_key_here"

# Session secret
SESSION_SECRET="your_session_secret_here"

# =============================================================================
# MONITORING
# =============================================================================
# Health check endpoint
HEALTH_CHECK_ENABLED="true"

# Metrics collection
METRICS_ENABLED="false" 