{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/kyc-attestation-platform/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/kyc-attestation-platform/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/kyc-attestation-platform",
  "projects": {
    "backend": {
      "type": "application",
      "root": "apps/backend",
      "entryFile": "main",
      "sourceRoot": "apps/backend/src",
      "compilerOptions": {
        "tsConfigPath": "apps/backend/tsconfig.app.json",
        "assets": ["**/*.json"],
        "watchAssets": true,
        "outputPath": "apps/backend/dist"
      }
    },
    "kyc-attestation-platform": {
      "type": "application",
      "root": "apps/kyc-attestation-platform",
      "entryFile": "main",
      "sourceRoot": "apps/kyc-attestation-platform/src",
      "compilerOptions": {
        "tsConfigPath": "apps/kyc-attestation-platform/tsconfig.app.json"
      }
    }
  }
}